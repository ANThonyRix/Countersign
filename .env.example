# Throwaway Sepolia testnet key ONLY. Telegraph requests are public and show the payer wallet.
# Generate one with: npm run wallet:new
AGENT_PRIVATE_KEY=0x...

# Telegraph testnet node
TELEGRAPH_NODE=https://devnode.telegraphprotocol.com
# Current Telegraph testnet supports Sepolia escrow. Use exact for legacy Sepolia nodes.
TELEGRAPH_PAYMENT_RAIL=escrow
# Optional: use exact x402 on Solana Devnet for Startup checks and confidential market snapshots.
# STARTUP_SOLANA_KEYPAIR_FILE=data/startup-devnet-keypair.json
# Optional: CLI signer for confidential computations. The browser uses the connected Devnet wallet.
# CONFIDENTIAL_SOLANA_KEYPAIR_FILE=data/confidential-devnet-keypair.json
# Timeout per Telegraph request, including its response body (milliseconds)
REQUEST_TIMEOUT_MS=60000

# Sepolia RPC used for balance reads and the test-USDC mint
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Spend limits in USD. The agent refuses to sign a payment that would cross either cap.
MAX_USD_PER_RUN=0.25
MAX_USD_PER_DAY=2.00
# Per-payment ceiling in 6-decimal USDC units (100000 = $0.10)
MAX_ATOMIC_PER_PAYMENT=100000

# Web UI port
PORT=4402

# Optional: extra Host names the web UI answers to, comma-separated (loopback is always allowed)
# ALLOWED_HOSTS=

# Public deployment behind a loopback reverse proxy (Caddy).
# PUBLIC_ORIGIN=https://countersign.ink
# TRUST_LOOPBACK_PROXY=true
# COUNTERSIGN_DATA_DIR=/var/lib/countersign
