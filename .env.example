# Throwaway Sepolia testnet key ONLY. Telegraph requests are public and show the payer wallet.
# Generate one with: npm run wallet:new
AGENT_PRIVATE_KEY=0x...

# Telegraph testnet node
TELEGRAPH_NODE=https://devnode.telegraphprotocol.com

# Sepolia RPC used for balance reads and the test-USDC mint
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Spend limits in USD. The agent refuses to sign a payment that would cross either cap.
MAX_USD_PER_RUN=0.25
MAX_USD_PER_DAY=2.00
# Per-payment ceiling in 6-decimal USDC units (100000 = $0.10)
MAX_ATOMIC_PER_PAYMENT=100000

# Web UI port
PORT=4402

# Optional: extra Host names the web UI answers to, comma-separated (loopback is always allowed)
# ALLOWED_HOSTS=
