[Unit]
Description=Countersign public demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=countersign
Group=countersign
WorkingDirectory=/opt/countersign
EnvironmentFile=/etc/countersign.env
ExecStart=/usr/bin/node --import tsx src/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/countersign
UMask=0077

[Install]
WantedBy=multi-user.target
